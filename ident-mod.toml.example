# Copy this file to ident-mod.toml and adapt the project-specific types.
use_canonical_type = true

[clang]
downgrade_all_warnings = false
downgrade_warnings = [] # "sign-conversion" or "-Wsign-conversion"

[migration]
legacy_prefixes = true # Recognize built-in legacy Hungarian prefixes.

[variables]
case = "pascal" # pascal / camel / snake
# Camel and snake append one separator when a non-empty type prefix lacks "_".

[scan]
local = true
static_local = true
member = true
static_member = true
global = true
static_global = true
functions = true

[scope]
local = ""
static_local = "s_"
member = "m_"
static_member = "s_"
global = "g_"
static_global = "s_"

[scope_alternatives.const]
global = ["upper_snake"]

[functions]
member = "camel"
free = "pascal"

[pointers]
marker = "p"
char = "s" # char* -> ps, char** -> pps

[types]
int = "n"
bool = "b"
double = "d"
"std::string" = "s"
"std::basic_string<char>" = "s"
"std::vector" = "vec"
"std::map" = "map"
"project::Request" = "req"
"project::Response" = "rsp"
"project::Context" = "ctx"
